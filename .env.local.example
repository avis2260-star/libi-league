# Copy this file to .env.local and fill in your Supabase project credentials.
# Find these in: Supabase Dashboard → Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>

# Service role key — SERVER ONLY. Never expose to the browser.
# Found in: Supabase Dashboard → Project Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# Comma-separated list of email addresses allowed to access /admin
ADMIN_EMAILS=you@example.com

# Public URL of the deployed site — used to build the MFA recovery magic link.
# Must be the real domain in production, e.g. https://ligat-libi.example.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend API key — sends the contact-form and MFA-recovery emails.
# Found in: Resend Dashboard → API Keys
RESEND_API_KEY=<your-resend-api-key>

# Optional: sender for the MFA recovery email. Defaults to Resend's shared
# sandbox sender, which can only deliver to the Resend account owner's address.
# Set this to an address on a domain you've verified in Resend to email any admin.
# RECOVERY_FROM_EMAIL=Ligat Libi <noreply@your-verified-domain.com>
